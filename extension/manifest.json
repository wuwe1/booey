{
  "manifest_version": 3,
  "name": "Booey",
  "version": "1.0.0",
  "key": "",
  "description": "Booey — bridge chrome.debugger to a local daemon for agent-driven control. Multi-browser: each profile gets a persistent id; set a label in the popup. The popup is a status/identity panel (daemon state, counters, label).",
  "permissions": [
    "debugger",
    "tabs",
    "activeTab",
    "storage",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Booey"
  }
}
